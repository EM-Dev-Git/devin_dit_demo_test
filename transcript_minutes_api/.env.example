# データベース
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT設定
JWT_SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# ログ設定
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# アプリケーション設定
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
